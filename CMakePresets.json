{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "san",
      "displayName": "Debug with ASan and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "SPP_SANITIZE": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Lint with clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "SPP_TIDY": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "san",
      "configurePreset": "san"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "san",
      "configurePreset": "san",
      "inherits": "debug",
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
